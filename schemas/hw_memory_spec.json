{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Memory Hardware Specification",
  "description": "Target MCU flash/EEPROM geometry for memory stack configuration.",
  "type": "object",
  "required": ["memory_type", "sectors", "page_size"],
  "properties": {
    "memory_type": {
      "type": "string",
      "enum": ["INTERNAL_FLASH", "EEPROM"],
      "description": "INTERNAL_FLASH → Fee+Fls, EEPROM → Ea+Eep"
    },
    "sectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "size", "count"],
        "properties": {
          "start": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]+$",
            "description": "Sector start address (hex)"
          },
          "size": {
            "type": "integer",
            "minimum": 256,
            "description": "Physical sector erase size in bytes"
          },
          "count": {
            "type": "integer",
            "minimum": 2,
            "description": "Number of sectors available for Fee/Ea (min 2 for wear leveling)"
          }
        }
      }
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "description": "Minimum write granularity in bytes"
    },
    "erase_value": {
      "type": "string",
      "default": "0xFF",
      "description": "Flash erase value (typically 0xFF for NOR flash)"
    },
    "max_erase_cycles": {
      "type": "integer",
      "minimum": 1000,
      "description": "Maximum erase cycles per sector (for wear leveling calculation)"
    }
  }
}
