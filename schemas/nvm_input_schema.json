{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Memory Stack Input — NvBlock Descriptors",
  "description": "Defines NvM blocks for automatic memory stack configuration.",
  "type": "object",
  "required": ["blocks"],
  "properties": {
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "size", "type"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "description": "Block name (C identifier compatible, used in SHORT-NAME)"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "Block data size in bytes (excluding CRC/header overhead)"
          },
          "type": {
            "type": "string",
            "enum": ["NATIVE", "REDUNDANT", "DATASET"],
            "description": "NvM block management type"
          },
          "asil": {
            "type": "string",
            "enum": ["QM", "ASIL_A", "ASIL_B", "ASIL_C", "ASIL_D"],
            "default": "QM",
            "description": "ASIL safety integrity level"
          },
          "use_crc": {
            "type": "boolean",
            "default": true,
            "description": "Enable CRC protection for this block"
          },
          "crc_type": {
            "type": "string",
            "enum": ["CRC16", "CRC32"],
            "description": "CRC type. Auto-determined if not specified (CRC16 <= 256B, CRC32 > 256B)"
          },
          "write_policy": {
            "type": "string",
            "enum": ["DURING_WRITEALL", "IMMEDIATE"],
            "default": "DURING_WRITEALL",
            "description": "When the block is written to NV memory"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "default": 10,
            "description": "Job priority (0 = highest/immediate, 255 = lowest)"
          },
          "default_value": {
            "type": "string",
            "description": "Default/ROM value (hex string, e.g. '0x00')"
          },
          "num_datasets": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Number of datasets (only for DATASET type blocks)"
          }
        }
      }
    }
  }
}
