<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ea_Config.arxml — Generated by autosar-memstack-agents
  Template: templates/Ea_Config.arxml.j2
  Used when memory_type == "EEPROM" (external EEPROM via Eep driver)
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>AUTOSAR</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Ea</SHORT-NAME>
          <ELEMENTS>
            <ECUC-MODULE-CONFIGURATION-VALUES>
              <SHORT-NAME>Ea</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-MODULE-DEF">/MICROSAR/Ea</DEFINITION-REF>
              <CONTAINERS>

                <!-- EaGeneral -->
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>EaGeneral</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Ea/EaGeneral</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/Ea/EaGeneral/EaDeviceIndex</DEFINITION-REF>
                      <VALUE>0</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                  </PARAMETER-VALUES>
                  <REFERENCE-VALUES>
                    <ECUC-REFERENCE-VALUE>
                      <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">/MICROSAR/Ea/EaGeneral/EaEepReference</DEFINITION-REF>
                      <VALUE-REF DEST="ECUC-CONTAINER-VALUE">/AUTOSAR/Eep/EepGeneral</VALUE-REF>
                    </ECUC-REFERENCE-VALUE>
                  </REFERENCE-VALUES>
                </ECUC-CONTAINER-VALUE>

                <!-- EaBlockConfiguration — one per NvM block -->
                {% for block in blocks %}
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>EaBlock_{{ block.name }}</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Ea/EaBlockConfiguration</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/Ea/EaBlockConfiguration/EaBlockNumber</DEFINITION-REF>
                      <VALUE>{{ block.fee_block_primary }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/Ea/EaBlockConfiguration/EaBlockSize</DEFINITION-REF>
                      <VALUE>{{ block.ea_block_size | default(block.size + 8 + block.crc_overhead) }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/MICROSAR/Ea/EaBlockConfiguration/EaImmediateData</DEFINITION-REF>
                      <VALUE>{{ 1 if block.priority == 0 else 0 }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                  </PARAMETER-VALUES>
                </ECUC-CONTAINER-VALUE>
                {% endfor %}

              </CONTAINERS>
            </ECUC-MODULE-CONFIGURATION-VALUES>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
