<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fls_Config.arxml — Generated by autosar-memstack-agents
  Template: templates/Fls_Config.arxml.j2
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>AUTOSAR</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Fls</SHORT-NAME>
          <ELEMENTS>
            <ECUC-MODULE-CONFIGURATION-VALUES>
              <SHORT-NAME>Fls</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-MODULE-DEF">/MICROSAR/Fls</DEFINITION-REF>
              <CONTAINERS>

                <!-- FlsGeneral -->
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>FlsGeneral</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Fls/FlsGeneral</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/Fls/FlsGeneral/FlsTotalSize</DEFINITION-REF>
                      <VALUE>{{ fls_config.sector_size * fls_config.sector_count }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                  </PARAMETER-VALUES>
                </ECUC-CONTAINER-VALUE>

                <!-- FlsSectorConfiguration -->
                {% for sector in fls_config.get('sectors', [fls_config]) %}
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>FlsSector_{{ loop.index0 }}</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Fls/FlsSectorConfiguration</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/Fls/FlsSectorConfiguration/FlsSectorStartAddress</DEFINITION-REF>
                      <VALUE>{{ sector.get('start', sector.get('sector_start', '0x00100000')) }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/Fls/FlsSectorConfiguration/FlsSectorSize</DEFINITION-REF>
                      <VALUE>{{ sector.get('size', sector.get('sector_size', 4096)) }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/Fls/FlsSectorConfiguration/FlsNumberOfSectors</DEFINITION-REF>
                      <VALUE>{{ sector.get('count', sector.get('sector_count', 8)) }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/Fls/FlsSectorConfiguration/FlsPageSize</DEFINITION-REF>
                      <VALUE>{{ fls_config.get('page_size', 8) }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                  </PARAMETER-VALUES>
                </ECUC-CONTAINER-VALUE>
                {% endfor %}

              </CONTAINERS>
            </ECUC-MODULE-CONFIGURATION-VALUES>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
