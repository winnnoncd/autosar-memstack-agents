<?xml version="1.0" encoding="UTF-8"?>
<!--
  NvM_Config.arxml — Generated by autosar-memstack-agents
  Template: templates/NvM_Config.arxml.j2
  DO NOT EDIT MANUALLY — regenerate via /configure-memstack
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>AUTOSAR</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>NvM</SHORT-NAME>
          <ELEMENTS>
            <ECUC-MODULE-CONFIGURATION-VALUES>
              <SHORT-NAME>NvM</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-MODULE-DEF">/MICROSAR/NvM</DEFINITION-REF>
              <CONTAINERS>

                <!-- NvMCommon: Global NvM settings -->
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>NvMCommon</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/NvM/NvMCommon</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/NvM/NvMCommon/NvMCompiledConfigId</DEFINITION-REF>
                      <VALUE>{{ config_id | default(1) }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/NvM/NvMCommon/NvMDatasetSelectionBits</DEFINITION-REF>
                      <VALUE>{{ dataset_selection_bits | default(0) }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/MICROSAR/NvM/NvMCommon/NvMJobPrioritization</DEFINITION-REF>
                      <VALUE>{{ 1 if has_priority_blocks else 0 }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                  </PARAMETER-VALUES>
                </ECUC-CONTAINER-VALUE>

                {% for block in blocks %}
                <!-- Block {{ block.nvm_block_id }}: {{ block.name }} ({{ block.asil }}) -->
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>NvMBlockDescriptor_{{ block.name }}</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/NvM/NvMBlockDescriptor</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <!-- Block identification -->
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/NvM/NvMBlockDescriptor/NvMNvBlockNum</DEFINITION-REF>
                      <VALUE>{{ block.nvm_block_id }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/NvM/NvMBlockDescriptor/NvMNvBlockBaseNumber</DEFINITION-REF>
                      <VALUE>{{ block.nvm_base_number }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <!-- Block size -->
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/NvM/NvMBlockDescriptor/NvMNvBlockLength</DEFINITION-REF>
                      <VALUE>{{ block.size }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <!-- Block management type -->
                    <ECUC-TEXTUAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-ENUMERATION-PARAM-DEF">/MICROSAR/NvM/NvMBlockDescriptor/NvMBlockManagementType</DEFINITION-REF>
                      <VALUE>{{ block.management_type }}</VALUE>
                    </ECUC-TEXTUAL-PARAM-VALUE>
                    <!-- Write policy -->
                    <ECUC-TEXTUAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-ENUMERATION-PARAM-DEF">/MICROSAR/NvM/NvMBlockDescriptor/NvMBlockWriteProt</DEFINITION-REF>
                      <VALUE>{{ block.write_policy }}</VALUE>
                    </ECUC-TEXTUAL-PARAM-VALUE>
                    <!-- Priority -->
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/NvM/NvMBlockDescriptor/NvMBlockJobPriority</DEFINITION-REF>
                      <VALUE>{{ block.priority }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    {% if block.use_crc %}
                    <!-- CRC configuration -->
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/MICROSAR/NvM/NvMBlockDescriptor/NvMBlockUseCrc</DEFINITION-REF>
                      <VALUE>1</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-TEXTUAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-ENUMERATION-PARAM-DEF">/MICROSAR/NvM/NvMBlockDescriptor/NvMBlockCrcType</DEFINITION-REF>
                      <VALUE>{{ block.crc_type }}</VALUE>
                    </ECUC-TEXTUAL-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/MICROSAR/NvM/NvMBlockDescriptor/NvMCalcRamBlockCrc</DEFINITION-REF>
                      <VALUE>{{ 1 if block.asil in ['ASIL_B', 'ASIL_C', 'ASIL_D'] else 0 }}</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    {% endif %}
                  </PARAMETER-VALUES>
                  <REFERENCE-VALUES>
                    <!-- Target block reference → Fee/Ea -->
                    <ECUC-REFERENCE-VALUE>
                      <DEFINITION-REF DEST="ECUC-CHOICE-REFERENCE-DEF">/MICROSAR/NvM/NvMBlockDescriptor/NvMTargetBlockReference</DEFINITION-REF>
                      {% if memory_type == 'FEE' %}
                      <VALUE-REF DEST="ECUC-CONTAINER-VALUE">/AUTOSAR/Fee/FeeBlockConfiguration/FeeBlock_{{ block.name }}</VALUE-REF>
                      {% else %}
                      <VALUE-REF DEST="ECUC-CONTAINER-VALUE">/AUTOSAR/Ea/EaBlockConfiguration/EaBlock_{{ block.name }}</VALUE-REF>
                      {% endif %}
                    </ECUC-REFERENCE-VALUE>
                  </REFERENCE-VALUES>
                </ECUC-CONTAINER-VALUE>
                {% endfor %}

              </CONTAINERS>
            </ECUC-MODULE-CONFIGURATION-VALUES>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
